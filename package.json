{
  "name": "reply-with-chatgpt",
  "version": "1.0.0",
  "private": true,
  "description": "Outlook add-in: copy a reply prompt for ChatGPT, then turn its answer into a reply draft. Static files only.",
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "start": "node scripts/serve.js",
    "test": "node --test",
    "validate": "office-addin-manifest validate manifest.xml",
    "manifest": "node scripts/make-manifest.js",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1"
  }
}
